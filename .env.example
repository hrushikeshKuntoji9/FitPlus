# ==============================================================================
# FitPulse Pro — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=          # Random 64-char hex string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development      # "development" or "production"
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=fitpulse.db  # Relative to project root. For production use an absolute path or external DB URL.

# ── Authentication ───────────────────────────────────────────────────────────
SESSION_EXPIRY_HOURS=168   # Session lifetime in hours (default: 7 days)
PASSWORD_SALT=             # Legacy salt for migrating old SHA-256 passwords. Leave blank for new deployments.

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=          # From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_SECRET=      # (Not used on frontend, only for server-side verification if needed)

# ── Domain & Deployment ──────────────────────────────────────────────────────
DOMAIN_NAME=fitpulse.app   # Your custom apex or subdomain
FRONTEND_URL=http://localhost:5000  # Set to https://yourdomain.com in production

# ── Razorpay Payment Gateway (India / INR) ───────────────────────────────────
# Create keys at https://dashboard.razorpay.com/app/keys
# Use TEST mode keys during development (start with rzp_test_)
RAZORPAY_KEY_ID=           # Public key (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_SECRET=       # Secret key (never expose in frontend code)
RAZORPAY_WEBHOOK_SECRET=   # Webhook secret from Razorpay Dashboard → Webhooks

# ── Stripe Payment Gateway (International Cards / USD / EUR / INR) ───────────
# Create keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=         # sk_test_... or sk_live_...
STRIPE_PUBLISHABLE_KEY=    # pk_test_... or pk_live_...
STRIPE_WEBHOOK_SECRET=     # whsec_...

# ── Live AI Coach Providers ──────────────────────────────────────────────────
# Choose ANY of the following providers. FitPulse automatically detects active keys.
# If no key is set, FitPulse uses its built-in context-aware heuristic reasoning engine.
OPENAI_API_KEY=            # sk-proj-... (https://platform.openai.com)
OPENAI_MODEL=gpt-4o-mini   # gpt-4o-mini | gpt-4o | gpt-3.5-turbo

GEMINI_API_KEY=            # AIza... (https://aistudio.google.com)
GEMINI_MODEL=gemini-1.5-flash # gemini-1.5-flash | gemini-pro

GROQ_API_KEY=              # gsk_... (Fast & free tier at https://console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=         # sk-ant-... (https://console.anthropic.com)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# ── Email Service ────────────────────────────────────────────────────────────
# Configure your email provider (e.g., SendGrid, Mailgun, AWS SES, SMTP)
EMAIL_PROVIDER=smtp        # "smtp" | "sendgrid" | "mailgun"
SMTP_HOST=                 # e.g., smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                 # Your email address
SMTP_PASSWORD=             # App password (not your regular password)
SMTP_FROM_NAME=FitPulse
SMTP_FROM_EMAIL=           # e.g., noreply@fitpulse.app

SENDGRID_API_KEY=          # If using SendGrid
MAILGUN_API_KEY=           # If using Mailgun
MAILGUN_DOMAIN=            # If using Mailgun

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000  # Comma-separated allowed origins. Set to your domain in production.

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5         # Max login attempts per 15-minute window per IP
RATE_LIMIT_REGISTER=3      # Max registration attempts per 15-minute window per IP
RATE_LIMIT_API=100         # Max general API requests per minute per IP

# ── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5000  # Used in email links. Set to your domain in production.

# ── Admin Setup ──────────────────────────────────────────────────────────────
# Initial admin account (created on first run if no admin exists)
ADMIN_EMAIL=admin@fitpulse.app
ADMIN_PASSWORD=            # Set a strong password for production. If blank, uses "admin1234" (development only).
ADMIN_NAME=FitPulse Admin
